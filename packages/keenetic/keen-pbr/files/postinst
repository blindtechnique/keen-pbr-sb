#!/bin/sh

umask 077

DNSMASQ_CONF="/opt/etc/dnsmasq.conf"
DNSMASQ_TEMPLATE="/opt/usr/lib/keen-pbr/dnsmasq.conf.template"
DNSMASQ_BACKUP="/opt/etc/dnsmasq.conf.backup-pre-keen-pbr"
METADATA_HELPER="/opt/usr/lib/keen-pbr/portable-stat.sh"
NFQWS_ROTATOR_REPORTER_SOURCE="/opt/usr/share/keen-pbr/nfqws-lua/rotator-telemetry.lua"
NFQWS_ROTATOR_REPORTER="/opt/var/lib/keen-pbr/nfqws-rotator-telemetry-v1.lua"

echo "keen-pbr installation"
echo "------------------------"

install_atomic_executable() {
    atomic_source=$1
    atomic_destination=$2
    atomic_temporary="${atomic_destination}.tmp.$$"
    rm -f "$atomic_temporary" || return 1
    if cp "$atomic_source" "$atomic_temporary" &&
       chmod 0755 "$atomic_temporary" &&
       mv -f "$atomic_temporary" "$atomic_destination"; then
        return 0
    fi
    rm -f "$atomic_temporary"
    return 1
}

install_atomic_data() {
    atomic_source=$1
    atomic_destination=$2
    atomic_temporary="${atomic_destination}.tmp.$$"
    rm -f "$atomic_temporary" || return 1
    if cp "$atomic_source" "$atomic_temporary" &&
       chmod 0644 "$atomic_temporary" &&
       mv -f "$atomic_temporary" "$atomic_destination"; then
        return 0
    fi
    rm -f "$atomic_temporary"
    return 1
}

mkdir -p /opt/usr/lib/keen-pbr
# The previous package's postrm may have mistaken a same-version reinstall for
# a final removal. Restore the early-boot guard before any later validation can
# fail, then refresh its durable helpers below.
if [ -x /opt/usr/lib/keen-pbr/rescue-startup-guard.sh ]; then
    install_atomic_executable \
        /opt/usr/lib/keen-pbr/rescue-startup-guard.sh \
        /opt/etc/init.d/S00keen-pbr-rescue || exit 1
    sync
fi
[ -f "$METADATA_HELPER" ] && [ ! -L "$METADATA_HELPER" ] || {
    echo "Portable metadata helper is missing or unsafe" >&2
    exit 1
}
. "$METADATA_HELPER" || exit 1

[ -f "$NFQWS_ROTATOR_REPORTER_SOURCE" ] &&
    [ ! -L "$NFQWS_ROTATOR_REPORTER_SOURCE" ] || {
    echo "Packaged nfqws rotator reporter is missing or unsafe" >&2
    exit 1
}
[ ! -L /opt/var/lib/keen-pbr ] &&
    { [ ! -e /opt/var/lib/keen-pbr ] ||
      [ -d /opt/var/lib/keen-pbr ]; } || {
    echo "Unsafe keen-pbr runtime data directory" >&2
    exit 1
}
mkdir -p /opt/var/lib/keen-pbr || exit 1
runtime_data_owner="$(keen_pbr_stat_value '%u' /opt/var/lib/keen-pbr)" ||
    exit 1
[ "$runtime_data_owner" = "$(id -u)" ] || {
    echo "Unsafe owner on keen-pbr runtime data directory" >&2
    exit 1
}
chmod 0755 /opt/var/lib/keen-pbr || exit 1
[ ! -L "$NFQWS_ROTATOR_REPORTER" ] &&
    { [ ! -e "$NFQWS_ROTATOR_REPORTER" ] ||
      [ -f "$NFQWS_ROTATOR_REPORTER" ]; } || {
    echo "Unsafe durable nfqws rotator reporter path" >&2
    exit 1
}
install_atomic_data \
    "$NFQWS_ROTATOR_REPORTER_SOURCE" \
    "$NFQWS_ROTATOR_REPORTER" || exit 1
[ -f "$NFQWS_ROTATOR_REPORTER" ] &&
    [ ! -L "$NFQWS_ROTATOR_REPORTER" ] &&
    cmp "$NFQWS_ROTATOR_REPORTER_SOURCE" \
        "$NFQWS_ROTATOR_REPORTER" >/dev/null 2>&1 || {
    echo "Durable nfqws rotator reporter verification failed" >&2
    exit 1
}
# This untracked schema-versioned copy is a future nfqws boot dependency even
# after keen-pbr itself is removed. Persist the rename and its directory entry
# now; upgrades may refresh implementation details within the v1 wire schema.
sync

[ ! -L /opt/var/lib/keen-pbr/rescue ] &&
    { [ ! -e /opt/var/lib/keen-pbr/rescue ] ||
      [ -d /opt/var/lib/keen-pbr/rescue ]; } || exit 1
mkdir -p /opt/var/lib/keen-pbr/rescue
rescue_owner="$(keen_pbr_stat_value '%u' /opt/var/lib/keen-pbr/rescue)" ||
    exit 1
[ "$rescue_owner" = "$(id -u)" ] || {
    echo "Unsafe owner on /opt/var/lib/keen-pbr/rescue" >&2
    exit 1
}
chmod 0700 /opt/var/lib/keen-pbr/rescue || exit 1
if [ -f "$METADATA_HELPER" ] && [ ! -L "$METADATA_HELPER" ]; then
    install_atomic_executable \
        "$METADATA_HELPER" \
        /opt/var/lib/keen-pbr/rescue/portable-stat.sh || exit 1
fi
if [ -x /opt/usr/lib/keen-pbr/rescue-update.sh ]; then
    install_atomic_executable \
        /opt/usr/lib/keen-pbr/rescue-update.sh \
        /opt/var/lib/keen-pbr/rescue/rescue-update.sh || exit 1
fi
if [ -x /opt/usr/lib/keen-pbr/update-lock.sh ]; then
    install_atomic_executable \
        /opt/usr/lib/keen-pbr/update-lock.sh \
        /opt/var/lib/keen-pbr/rescue/update-lock.sh || exit 1
fi
# Package scripts must never invoke persistent-state recovery recursively.
# Check the durable guard before making any package-owned configuration
# mutation; managed package rescue may bypass only its own PENDING marker.
if [ -x /opt/etc/init.d/S00keen-pbr-rescue ] &&
   ! KEEN_PBR_PACKAGE_POSTINST=1 \
     /opt/etc/init.d/S00keen-pbr-rescue start; then
    echo "keen-pbr recovery is pending; refusing package postinst" >&2
    exit 1
fi

answer=""
if [ -f "$DNSMASQ_TEMPLATE" ]; then
    if [ -n "${KEEN_PBR_REPLACE_DNSMASQ_DEFAULTS:-}" ]; then
        answer="$KEEN_PBR_REPLACE_DNSMASQ_DEFAULTS"
    elif [ -t 0 ] && [ -t 1 ]; then
        echo "Tip: set KEEN_PBR_REPLACE_DNSMASQ_DEFAULTS=Y or N to automate keen-pbr installation."
        while :; do
            printf "Replace %s with recommended keen-pbr dnsmasq defaults? [y/n]: " "$DNSMASQ_CONF"
            read answer || answer=""
            case "$answer" in
                y|Y|n|N)
                    break
                    ;;
                *)
                    echo "Please enter Y or N."
                    ;;
            esac
        done
    else
        echo "Tip: set KEEN_PBR_REPLACE_DNSMASQ_DEFAULTS=Y or N to automate keen-pbr installation."
    fi
fi

case "$answer" in
    y|Y)
        if [ -f "$DNSMASQ_CONF" ]; then
            printf "Backing up existing %s to %s\n" "$DNSMASQ_CONF" "$DNSMASQ_BACKUP"
            cp "$DNSMASQ_CONF" "$DNSMASQ_BACKUP"
        fi
        printf "Installing recommended keen-pbr dnsmasq base config to %s\n" "$DNSMASQ_CONF"
        cp "$DNSMASQ_TEMPLATE" "$DNSMASQ_CONF"
        ;;
    n|N)
        echo "Keeping existing dnsmasq base config unchanged."
        ;;
    "")
        ;;
    *)
        printf "Ignoring invalid KEEN_PBR_REPLACE_DNSMASQ_DEFAULTS value: %s. Use Y or N.\n" "$answer"
        ;;
esac

echo ""
TRANSPORT_CONFIG="/opt/etc/keen-pbr/transports.json"
if [ -f "$TRANSPORT_CONFIG" ] && grep -q 'REPLACE_WITH_A_LONG_RANDOM_VALUE' "$TRANSPORT_CONFIG"; then
    # BusyBox od on Entware does not support the GNU -A option.  Hashing
    # random bytes gives us a portable, fixed-width 64-character key.
    transport_api_key="$(head -c 64 /dev/urandom | sha256sum | cut -d ' ' -f1)"
    sed -i "s/REPLACE_WITH_A_LONG_RANDOM_VALUE/$transport_api_key/" "$TRANSPORT_CONFIG"
fi
chmod 600 "$TRANSPORT_CONFIG" 2>/dev/null || true

# Older keen-pbr-sb builds could atomically replace nfqws2 files with mode
# 0600. nfqws2 drops privileges to nobody, so repair read/traverse access on
# upgrade without changing file contents.
if [ -d /opt/etc/nfqws2 ]; then
    chmod 0755 /opt/etc/nfqws2 2>/dev/null || true
    for directory in /opt/etc/nfqws2/lists /opt/etc/nfqws2/lua; do
        [ -d "$directory" ] || continue
        chmod 0755 "$directory" 2>/dev/null || true
        find "$directory" -type f \( -name '*.list' -o -name '*.lua' \) \
            -exec chmod 0644 {} \; 2>/dev/null || true
    done
    chmod 0644 /opt/etc/nfqws2/nfqws2.conf 2>/dev/null || true
fi
if ! KEEN_PBR_PACKAGE_POSTINST=1 \
     /opt/etc/init.d/S79transport-manager start; then
    echo "Failed to start transport-manager service" >&2
    exit 1
fi
if ! KEEN_PBR_PACKAGE_POSTINST=1 \
     /opt/etc/init.d/S80keen-pbr start; then
    echo "Failed to start keen-pbr service" >&2
    exit 1
fi

# A daemon started from inside postinst can come up unable to apply any urltest
# selection, and it does not recover on its own.
#
# Measured on a live router 30.08.2026, build 20260830153713: after an opkg
# install every urltest table kept only its unreachable kill-switch, so the
# firewall rules that mark traffic into those groups sent it nowhere - fourteen
# lists black-holed. The daemon was not idle: 29 urltest commits in about three
# minutes, every one of them admitted=false (12 deferred behind a runtime
# mutation, 17 refused as "typed firewall transition was not admitted"), each
# refusal immediately requesting another probe round. It never converged.
#
# Restarting the service afterwards converged within ~30s on every attempt, and
# stopping and starting both services outside opkg converged too - so the
# trigger belongs to the install path, not to starting the two services at once.
# Waiting for the tunnels before starting keen-pbr would therefore not help.
#
# This is a workaround. The defect is in the transition admission path; it is
# only detected here, where the signature is unambiguous: a rule marked into a
# urltest group whose own mark is not one of its children.
KEEN_PBR_BIN="/opt/usr/bin/keen-pbr"
if [ "${KEEN_PBR_INSTALLER_RESTARTS:-0}" = "1" ]; then
    # install.sh --update restarts the service itself as soon as opkg returns,
    # which cures the same state. Doing it here too would restart twice in a
    # row and add this wait to every update for nothing.
    :
elif [ -x "$KEEN_PBR_BIN" ]; then
    # One initial probe round has to finish first. A child that is down costs
    # three attempts of five seconds plus their gaps, so allow a little more.
    sleep 20
    if "$KEEN_PBR_BIN" status 2>/dev/null \
        | grep -q "is not a child of urltest outbound"; then
        echo "Routing did not settle after install; restarting keen-pbr..."
        KEEN_PBR_PACKAGE_POSTINST=1 \
            /opt/etc/init.d/S80keen-pbr restart >/dev/null 2>&1 || true
    fi
fi
echo ""

echo "Installation complete!"
echo "Config path: /opt/etc/keen-pbr/config.json"
echo "Web API: http://my.keenetic.net:12121"

exit 0
