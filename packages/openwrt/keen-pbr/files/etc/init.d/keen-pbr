#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

if type extra_command >/dev/null 2>&1; then
    extra_command "reapply_firewall" " Send SIGUSR1 to the running service"
    extra_command "reapply_nat" " Send SIGUSR2 to repair NAT state"
    extra_command "reapply_dnsmasq_config" " Regenerate keen-pbr dnsmasq config and restart dnsmasq"
    extra_command "sync_firewall_hook" " Ensure the fw4 include exists for keen-pbr"
    extra_command "remove_firewall_hook" " Remove the fw4 include for keen-pbr"
else
    EXTRA_COMMANDS="reapply_firewall reapply_nat reapply_dnsmasq_config sync_firewall_hook remove_firewall_hook"
    EXTRA_HELP="        reapply_firewall        Send SIGUSR1 to the running service
        reapply_nat             Send SIGUSR2 to repair NAT state
        reapply_dnsmasq_config  Regenerate keen-pbr dnsmasq config and restart dnsmasq
        sync_firewall_hook      Ensure the fw4 include exists for keen-pbr
        remove_firewall_hook    Remove the fw4 include for keen-pbr"
fi

PROG=/usr/sbin/keen-pbr
CONFIG=/etc/keen-pbr/config.json
HELPER=/usr/lib/keen-pbr/dnsmasq.sh
UCI_HELPER=/usr/lib/keen-pbr/uci.sh
PIDFILE=/var/run/keen-pbr.pid
PROC_ROOT=${KEEN_PBR_PROC_ROOT:-/proc}

script_name() {
    basename "${initscript:-$0}"
}

rc_root() {
    printf '%s' "${IPKG_INSTROOT:-}"
}

start_link_path() {
    printf '%s/etc/rc.d/S%02d%s' "$(rc_root)" "$START" "$(script_name)"
}

stop_link_path() {
    printf '%s/etc/rc.d/K%02d%s' "$(rc_root)" "$STOP" "$(script_name)"
}

ensure_fw4_include() {
    [ -x "$UCI_HELPER" ] || return 1
    "$UCI_HELPER" firewall-sync
}

remove_fw4_include() {
    [ -x "$UCI_HELPER" ] || return 1
    "$UCI_HELPER" firewall-remove
}

is_enabled() {
    [ -L "$(start_link_path)" ] || [ -L "$(stop_link_path)" ]
}

enable() {
    local root name

    root="$(rc_root)"
    name="$(script_name)"

    mkdir -p "$root/etc/rc.d"
    ln -sf "../init.d/${name}" "$(start_link_path)"
    ln -sf "../init.d/${name}" "$(stop_link_path)"

    [ -n "$IPKG_INSTROOT" ] && return 0

    ensure_fw4_include || return 1

    if [ -x "$HELPER" ]; then
        "$HELPER" install-persistent || return 1
    fi
}

disable() {
    rm -f "$(start_link_path)" "$(stop_link_path)"

    [ -n "$IPKG_INSTROOT" ] && return 0

    remove_fw4_include || return 1

    if [ -x "$HELPER" ]; then
        "$HELPER" uninstall-persistent || return 1
    fi
}

start_service() {
    [ -x "$PROG" ] || return 1
    [ -f "$CONFIG" ] || return 1

    ensure_fw4_include || return 1

    mkdir -p /var/cache/keen-pbr

    if [ -x "$HELPER" ]; then
        "$HELPER" activate || return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" --config "$CONFIG" --pid-file "$PIDFILE" service
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    [ -n "$KEEN_PBR_SKIP_DNSMASQ" ] && return 0
    is_enabled || return 0

    if [ -x "$HELPER" ]; then
        "$HELPER" deactivate || true
    fi
}

pid_is_keen_pbr_service() {
    local pid="$1"
    local executable
    local cmdline

    case "$pid" in
        *[!0-9]*|'') return 1 ;;
    esac
    [ -r "$PROC_ROOT/$pid/cmdline" ] || return 1
    cmdline="$(tr '\000' '\n' < "$PROC_ROOT/$pid/cmdline" 2>/dev/null)" ||
        return 1
    executable="$(printf '%s\n' "$cmdline" | head -n 1)"
    [ "$(basename "$executable")" = "$(basename "$PROG")" ] || return 1
    printf '%s\n' "$cmdline" | grep -qx 'service'
}

signal_service() {
    local signal="$1"
    local pid

    [ -s "$PIDFILE" ] || return 1
    read -r pid < "$PIDFILE" || return 1
    pid_is_keen_pbr_service "$pid" || return 1
    kill "-$signal" "$pid"
}

reload_service() {
    reapply_dnsmasq_config || return 1
    signal_service HUP
}

reapply_firewall() {
    signal_service SIGUSR1
}

reapply_nat() {
    signal_service SIGUSR2
}

reapply_dnsmasq_config() {
    if [ -x "$HELPER" ]; then
        "$HELPER" activate || return 1
    fi
}

sync_firewall_hook() {
    ensure_fw4_include
}

remove_firewall_hook() {
    remove_fw4_include
}
