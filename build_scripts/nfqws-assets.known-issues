# Подтверждённые расхождения в assets nfqws2, ожидающие решения владельца.
#
# Дубли и неверно названный max.ru устранены после фиксации источника,
# лицензии и origin-хешей. Оставшиеся строки — точные отпечатки legacy-долга:
# gate падает на любое неизвестное расхождение и на устаревший waiver.
# Поля разделены `|`, чтобы имена профилей с пробелами оставались однозначными.

# Десять прежних shallow-pool исключений устранены адресными пулами:
# исходный slot 1 сохранён, отдельные keys и ranges проверяются генератором
# и executable Lua fixture. Прочие восемь исключений ниже не изменены.

# Остатки переписки автора с ассистентом. Каждый точный marker учитывается
# отдельно, поэтому второй фрагмент в уже известном профиле остаётся новым долгом.
dialogue|ver2|your previous|count=1|sha256=3f38a05cd1f040e2277b12edb8e0f916b0aa8fe9e373e7183723292ba870cdd0
dialogue|ver2|your file|count=1|sha256=7ba4d8a4d71d67484c67e9c516c99a0174bd61a3c09ff6cd92c77434e46ae6d9
dialogue|ver3 safe|rollback baseline|count=1|sha256=a26e4219cdc2ab1654f9730f54f96e6913529f659c450610c0b45c3d491bdd78
dialogue|ver3 safe|your file|count=1|sha256=a26e4219cdc2ab1654f9730f54f96e6913529f659c450610c0b45c3d491bdd78

# Опечатки являются частью пользовательского имени и URL API; переименование
# требует отдельной миграции сохранённого выбора.
typo|ver5 aggresive|aggresive|aggressive
typo|ver7 more aggresive|aggresive|aggressive
typo|ver8 max aggresive|aggresive|aggressive

# Сейчас только default имеет IPV6_ENABLED=1, остальные двенадцать — 0. Ключ
# фиксирует обе стороны, поэтому изменение majority не будет принято молча.
ipv6-exception|default|value=1|baseline=0

# Original upstream 1.2.8 reference, not one of our improved presets. It must
# remain byte-for-byte stock to recognize existing installations and offer
# that named configuration. The upstream QUIC action is intentionally not
# replaced by our circular pool; upstream postinst detects IPv6 separately.
# tests/test_nfqws_config.cpp pins the full reference and Giga postinst hash.
# Source: tests/fixtures/nfqws2-keenetic-1.2.8/SOURCE.md.
shallow-pool|default (nfqws2 1.2.8)|quic|present=1|sha256=bbfd8a3e63516763132900afab2f226997bc50b8364339ef5399334aec7353ca|circular=0|ids=0|bodies=0
ipv6-exception|default (nfqws2 1.2.8)|value=1|baseline=0
